function getDatos() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  return sheet.getDataRange().getValues();
}
function ls(arg) {
  const datos = getDatos();
  const resultado = [];

  const headers = datos[0];

  const idxTel = headers.indexOf("telefono");
  const idxWeb = headers.indexOf("www");
  const idxCorreo = headers.indexOf("correoelec");

  for (let i = 1; i < datos.length; i++) {
    const fila = datos[i];

    const tel = fila[idxTel];
    const web = fila[idxWeb];
    const correo = fila[idxCorreo];

    if (arg == 't' && tel) resultado.push(fila);
    if (arg == 'w' && web) resultado.push(fila);
    if (arg == 'c' && correo) resultado.push(fila);
    if (arg == 'a' && tel && web && correo) resultado.push(fila);
  }

  Logger.log(resultado);
  return resultado;
}
function ls_v(tipoVialidad, nombreVialidad) {
  const datos = getDatos();
  const resultado = [];

  const headers = datos[0];

  const idxTipo = headers.indexOf("tipo_vial");
  const idxNombre = headers.indexOf("nom_vial");

  for (let i = 1; i < datos.length; i++) {
    const fila = datos[i];

    if (
      fila[idxTipo] == tipoVialidad &&
      fila[idxNombre] == nombreVialidad
    ) {
      resultado.push(fila);
    }
  }

  Logger.log(resultado);
  return resultado;
}
function calcularDistancia(lat1, lon1, lat2, lon2) {
  const R = 6371;

  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;

  const a =
    Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(lat1 * Math.PI/180) *
    Math.cos(lat2 * Math.PI/180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);

  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));

  return R * c;
}
function lsGPS(lat, lng) {
  const datos = getDatos();
  let cercanos = [];

  const headers = datos[0];

  const idxLat = headers.indexOf("latitud");
  const idxLng = headers.indexOf("longitud");

  for (let i = 1; i < datos.length; i++) {
    const fila = datos[i];

    const lat2 = parseFloat(fila[idxLat]);
    const lng2 = parseFloat(fila[idxLng]);

    if (!lat2 || !lng2) continue;

    const distancia = calcularDistancia(lat, lng, lat2, lng2);

    if (distancia <= 3) {
      cercanos.push({ fila: fila, dist: distancia });
    }
  }

  cercanos.sort((a, b) => a.dist - b.dist);

  const resultado = cercanos.slice(0, 5).map(e => e.fila);

  Logger.log(resultado);
  return resultado;
}
function prueba() {
  ls('t');
}
